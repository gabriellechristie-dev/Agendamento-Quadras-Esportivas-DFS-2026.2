// Generator

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Datasource

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums

enum StatusQuadra {
  DISPONIVEL
  INDISPONIVEL
}

enum StatusReserva {
  ATIVA
  CANCELADA
  CONCLUIDA
}

// Models

model Jogador {
  id            String    @id @default(uuid()) @db.Uuid
  nomeCompleto  String
  email         String    @unique
  telefone      String
  senha         String

  reservas      Reserva[]
}

model Administrador {
  id        String @id @default(uuid()) @db.Uuid
  nome      String
  email     String @unique
  telefone  String
  senha     String
}

model Quadra {
  id           String         @id @default(uuid()) @db.Uuid
  nome         String
  modalidade   String
  localizacao  String
  status       StatusQuadra

  reservas     Reserva[]
}

model Reserva {
  id             String          @id @default(uuid()) @db.Uuid

  jogadorId      String          @db.Uuid
  jogador        Jogador         @relation(fields: [jogadorId], references: [id], onDelete: Restrict)

  quadraId       String          @db.Uuid
  quadra         Quadra          @relation(fields: [quadraId], references: [id], onDelete: Restrict)

  data           DateTime
  horarioInicio  DateTime
  horarioFim     DateTime
  status         StatusReserva
  dataCriacao    DateTime        @default(now())
}